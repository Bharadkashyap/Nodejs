<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>student</title>
</head>

<body>
    <h1>Student Information</h1>
    <table border="1">
        <tr>

            <td>name</td>
            <td>Age</td>
            <td>Email</td>
            <td colspan=2>Operation</td>
        </tr>

        <!-- we use for Each loop for iterating purpose -->
        <% result.forEach((student)=>{%>
            <tr>

                <td>
                    <%= student.name %>
                </td>
                <td>
                    <%= student.age %>
                </td>
                <td>
                    <%= student.email %>
                </td>
                <td><a href="/ui/delete/<%= student._id %>">Delete</a></td>
                <td><a href="/ui/student/<%= student._id %>">update</a></td>
            </tr>
            <% })%>

    </table>


</body>

</html>